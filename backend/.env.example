# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_wolf

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Rate Limiting
RATE_LIMIT_AUTH=5
RATE_LIMIT_AI=10
RATE_LIMIT_WS_MSG=20

# Game Settings
GAME_REPLAY_RETENTION_DAYS=30
ROOM_IDLE_TIMEOUT_MINUTES=30

# Email (test mode - logs only)
EMAIL_TEST_MODE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aiwolf.example.com

# Voice (stub mode)
VOICE_ENABLED=false
